[
  {
    "name": "echo",
    "description": "Return the given text verbatim.",
    "requires_approval": false,
    "parameters": {
      "type": "object",
      "properties": {
        "text": { "type": "string" }
      },
      "required": ["text"]
    }
  },
  {
    "name": "run_code",
    "description": "Execute arbitrary code in a sandbox. Always requires human approval.",
    "requires_approval": true,
    "parameters": {
      "type": "object",
      "properties": {
        "language": { "type": "string", "enum": ["python", "javascript", "bash"] },
        "code": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["language", "code"]
    }
  },
  {
    "name": "web_search",
    "description": "Search the web and return top results. kind='web' for general web search, kind='news' for latest headlines, kind='wikipedia' for encyclopedia entries. Does not require approval.",
    "requires_approval": false,
    "parameters": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["web", "news", "wikipedia"] },
        "max_results": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "required": ["query"]
    }
  },
  {
    "name": "fetch_url",
    "description": "Fetch a URL and return its text content as trimmed plain text. Use when a search snippet is not enough and you need the actual page content. Does not require approval.",
    "requires_approval": false,
    "parameters": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "max_chars": { "type": "integer", "minimum": 200, "maximum": 20000 }
      },
      "required": ["url"]
    }
  },
  {
    "name": "send_email",
    "description": "Send an email message.",
    "requires_approval": false,
    "parameters": {
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["to", "subject", "body"]
    }
  },
  {
    "name": "send_message",
    "description": "Send a chat message to a messaging channel.",
    "requires_approval": false,
    "parameters": {
      "type": "object",
      "properties": {
        "channel": { "type": "string", "enum": ["whatsapp", "telegram"] },
        "to": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["channel", "to", "text"]
    }
  },
  {
    "name": "create_docx",
    "description": "Create a .docx document from a title and a list of sections.",
    "requires_approval": false,
    "parameters": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "sections": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "heading": { "type": "string" },
                  "body": {
                    "anyOf": [
                      { "type": "string" },
                      { "type": "array", "items": { "type": "string" } }
                    ]
                  }
                },
                "required": ["heading"]
              }
            },
            {
              "type": "object",
              "properties": {
                "heading": { "type": "string" },
                "body": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "array", "items": { "type": "string" } }
                  ]
                }
              },
              "required": ["heading"]
            }
          ]
        }
      },
      "required": ["title", "sections"]
    }
  },
  {
    "name": "create_pptx",
    "description": "Create a .pptx presentation from a title and a list of slides.",
    "requires_approval": false,
    "parameters": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slides": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "bullets": {
                    "anyOf": [
                      { "type": "array", "items": { "type": "string" } },
                      { "type": "string" }
                    ]
                  }
                },
                "required": ["title"]
              }
            },
            {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "bullets": {
                  "anyOf": [
                    { "type": "array", "items": { "type": "string" } },
                    { "type": "string" }
                  ]
                }
              },
              "required": ["title"]
            }
          ]
        }
      },
      "required": ["title", "slides"]
    }
  }
]