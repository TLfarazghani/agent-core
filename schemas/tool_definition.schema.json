{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-core.local/schemas/tool_definition.schema.json",
  "title": "ToolDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "parameters"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "requires_approval": { "type": "boolean", "default": false },
    "read_only": {
      "type": "boolean",
      "default": false,
      "description": "Phase 8: a non-mutating tool. plan permission mode runs only read_only tools; strict parks everything else."
    },
    "parameters": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "object" }
      }
    }
  }
}
