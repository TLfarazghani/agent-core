{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-core.local/schemas/agent_state.schema.json",
  "title": "AgentState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "target",
    "model",
    "messages",
    "max_turns",
    "turn_count",
    "pending_approval"
  ],
  "properties": {
    "session_id": { "type": "string" },
    "target": { "enum": ["windows", "android", "webgpu"] },
    "model": { "type": "string" },
    "messages": {
      "type": "array",
      "items": { "$ref": "chat_message.schema.json" }
    },
    "max_turns": { "type": "integer", "minimum": 1, "default": 8 },
    "turn_count": { "type": "integer", "minimum": 0, "default": 0 },
    "pending_approval": {
      "type": ["object", "null"],
      "required": ["call_id", "tool_name", "arguments"],
      "properties": {
        "call_id": { "type": "string" },
        "tool_name": { "type": "string" },
        "arguments": { "type": "object" }
      }
    },
    "pending_calls": {
      "type": "array",
      "items": { "$ref": "chat_message.schema.json#/$defs/toolCall" },
      "description": "Tool calls from the current turn parked behind a pending_approval; resumed by resolve_approval."
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Consecutive tool failures in the current user turn; retry-once stops the loop past the limit."
    },
    "permission_mode": {
      "enum": ["default", "plan", "auto", "strict"],
      "default": "default",
      "description": "Phase 8 permission mode, enforced inside tool_registry.dispatch(). run_code is never bypassable in any mode."
    },
    "plan": {
      "type": ["object", "null"],
      "default": null,
      "description": "Explicit multi-step task plan. Step tools still hit the hardcoded approval gate independently.",
      "required": ["goal", "steps"],
      "properties": {
        "goal": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "status": {
                "enum": ["pending", "in_progress", "done", "failed", "skipped"],
                "default": "pending"
              },
              "result": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "default": [],
      "description": "Phase 11 task backlog, distinct from plan. Persists with the session.",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "status": {
            "enum": ["pending", "in_progress", "done", "failed", "skipped"],
            "default": "pending"
          },
          "result": { "type": ["string", "null"] }
        }
      }
    },
    "active_subagents": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Phase 10: number of sub-agents currently running (one level deep; inspection only)."
    },
    "tool_allowlist": {
      "type": ["array", "null"],
      "default": null,
      "items": { "type": "string" },
      "description": "Phase 10: when set, dispatch denies tools not in this list (a skill's allowlist). Not an approval bypass."
    },
    "usage": {
      "type": "array",
      "default": [],
      "description": "Phase 12 telemetry: one record per provider generate (server-reported prompt/completion tokens + generation latency). Feeds /cost, /context, and the web sidebar usage readout.",
      "items": {
        "type": "object",
        "properties": {
          "prompt_tokens": { "type": "integer", "minimum": 0 },
          "completion_tokens": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "latency_s": { "type": "number", "minimum": 0 },
          "at": { "type": "number" }
        }
      }
    }
  }
}